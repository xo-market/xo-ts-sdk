{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // As a Node project resolves the package: through its `exports`, types from the built `dist`.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
