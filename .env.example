# The settings of the examples. Copy this file to .env (git ignores it) and fill in what the
# examples you run need. This is mainnet: use a key made for this, for an account that holds
# only what you mean to risk.

# Your wallet's private key: 0x and 64 hex characters. Every example that signs in needs it.
# Set it here, not on the command line (XO_PK=0x... cmd): that writes it into your shell history.
XO_PK=

# positions:list: the address of any XO wallet, to list its positions (no key needed).
XO_WALLET=

# smart-wallet:create-order: a smart wallet that XO_PK owns (smart-wallet:address lists them).
XO_SMART_WALLET=

# Optional: how much USDC bridge:deposit deposits from Base (default 5).
XO_DEPOSIT=

# usdc:transfer: the address to send 1 USDC to.
XO_TO=
