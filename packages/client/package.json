{
  "name": "@xomarket/client",
  "version": "0.5.0",
  "description": "TypeScript SDK for XO Market",
  "license": "MIT",
  "keywords": [
    "xo",
    "xo-market",
    "prediction-market",
    "orderbook",
    "market-making",
    "liquidity-rewards",
    "sdk",
    "typescript",
    "viem"
  ],
  "homepage": "https://docs.xo.market/typescript-sdk/overview",
  "bugs": {
    "url": "https://github.com/xo-market/xo-ts-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xo-market/xo-ts-sdk.git",
    "directory": "packages/client"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./signing": {
      "import": {
        "types": "./dist/signing/index.d.ts",
        "default": "./dist/signing/index.js"
      },
      "require": {
        "types": "./dist/signing/index.d.cts",
        "default": "./dist/signing/index.cjs"
      }
    },
    "./viem": {
      "import": {
        "types": "./dist/viem.d.ts",
        "default": "./dist/viem.js"
      },
      "require": {
        "types": "./dist/viem.d.cts",
        "default": "./dist/viem.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack . --profile node16 && node scripts/check-dts.mjs",
    "route-coverage": "tsx scripts/route-coverage.ts"
  },
  "dependencies": {
    "socket.io-client": "^4.8.4",
    "viem": "^2.57.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "msw": "2.15.0",
    "publint": "0.3.25",
    "socket.io": "4.8.4",
    "tsdown": "0.23.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "ws": "8.22.1"
  }
}
